###############################################################################
# consumer-fatw-ecs/stage/main.tf.tmpl  --  THE ONE LINE
#
# NOTE: your consumer uses main.tf.tmpl rendered by envsubst. This change is
# a plain Terraform expression containing a DOT (local.ecs_task_definition_
# effective), and GNU envsubst only substitutes valid shell names
# ([A-Za-z_][A-Za-z0-9_]*). A dot makes it an invalid name, so envsubst
# leaves it alone. No escaping needed. Do NOT write $${...}.
###############################################################################

module "ecs" {
  source = "..."   # unchanged

  # ... every other argument unchanged ...

  ecs_cluster_name = var.ecs_cluster_name
  ecs_service      = var.ecs_service

  # BEFORE
  # ecs_task_definition = var.ecs_task_definition

  # AFTER
  ecs_task_definition = local.ecs_task_definition_effective
}

###############################################################################
# That is the entire integration.
#
# - The five non-Datadog task definitions (Frontend, DB-Import, Scraper,
#   Importer, Exporter) pass through byte-identical -> no plan diff.
# - FATW-Dev-Backend-TD arrives with datadog-agent added to its
#   container_definitions map and DD_* merged into the backend container's
#   environment.
# - ngdc-ecs-cluster-module remains the ONLY owner of
#   aws_ecs_task_definition.
# - Task-level cpu/memory are not touched anywhere.
#
# If var.ecs_service is typed strictly in dev/variable.tf and rejects the new
# dd_* keys when passed on to the module, strip them here -- see the note at
# the bottom of variables.tf.datadog-additions.
