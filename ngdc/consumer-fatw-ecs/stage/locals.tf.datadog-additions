###############################################################################
# locals.tf  --  DATADOG ADDITIONS
#
# Merge into your existing locals.tf. Identical in dev/test/stage/prod.
###############################################################################

locals {
  # The opt-in filter. frontend_service has no datadog_enabled key, so try()
  # returns false and it is excluded entirely -- no module instance, no
  # sidecars, no plan diff.
  dd_services = {
    for name, svc in var.ecs_service : name => svc
    if try(svc.datadog_enabled, false)
  }

  # ---------------------------------------------------------------------------
  # Helper maps consumed by the task-definition resource.
  #
  # Keyed over ALL services, not just the Datadog ones, so the task-definition
  # code can lookup() unconditionally and stay branch-free.
  # ---------------------------------------------------------------------------
  dd_sidecars = {
    for name, svc in var.ecs_service : name => try(
      module.datadog[name].container_definitions, []
    )
  }

  dd_extra_cpu = {
    for name, svc in var.ecs_service : name => try(
      module.datadog[name].additional_cpu, 0
    )
  }

  dd_extra_memory = {
    for name, svc in var.ecs_service : name => try(
      module.datadog[name].additional_memory, 0
    )
  }
}
