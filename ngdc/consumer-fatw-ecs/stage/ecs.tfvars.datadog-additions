###############################################################################
# stage/ecs.tfvars  --  DATADOG ADDITIONS ONLY
#
# NOTE: stage's last commit in your repo is Revert "added data.tf and
# referenced th...". Confirm stage is actually in a known-good state before
# layering this on top -- a revert usually means something went sideways and
# was backed out rather than fixed.
###############################################################################

# --- In your existing ecs_service map -----------------------------------
#
# frontend_service: add NOTHING.
#
# backend_service:
#
#   datadog_enabled = true
#   dd_log_source   = "java"
#   cpu             = 832             # 832  + 192 = 1024  OK
#   memory          = 1408            # 1408 + 640 = 2048  OK
#
# If stage mirrors prod sizing rather than dev, use the prod numbers instead
# (1856/3456) -- stage is where you want to catch a Fargate size rejection,
# not prod.

###############################################################################
# Datadog globals
###############################################################################

dd_site = "ddog-gov.com"

dd_api_key_secret_name = "platform/datadog/gov-api-key"

dd_tags = {
  team        = "fatw"
  cost_center = "cc-4471"
  partition   = "govcloud"
}

dd_proxy_https = null

dd_agent_image     = "<acct>.dkr.ecr.us-gov-west-1.amazonaws.com/datadog/agent@sha256:REPLACE"
dd_fluentbit_image = "<acct>.dkr.ecr.us-gov-west-1.amazonaws.com/datadog/aws-for-fluent-bit@sha256:REPLACE"

module_registry        = "gitlab.example.com"
datadog_module_version = "1.0.0"
