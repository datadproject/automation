###############################################################################
# prod/ecs.tfvars  --  DATADOG ADDITIONS ONLY
#
# Go last, and only after stage has run this for a full business cycle.
###############################################################################

# --- In your existing ecs_service map -----------------------------------
#
# frontend_service: add NOTHING.
#
# backend_service:
#
#   datadog_enabled = true
#   dd_log_source   = "java"
#
#   # Prod sizing. Sidecars still add 192/640, so the app numbers change but
#   # the arithmetic does not:
#   cpu    = 1856    # 1856 + 192 = 2048  OK
#   memory = 3456    # 3456 + 640 = 4096  OK  (legal for 2048 cpu)
#
#   # Optional, prod only. Continuous profiler is billed separately by
#   # Datadog per host -- get sign-off before enabling.
#   # dd_enable_profiling = true

###############################################################################
# Datadog globals
###############################################################################

dd_site = "ddog-gov.com"

dd_api_key_secret_name = "platform/datadog/gov-api-key"

dd_tags = {
  team        = "fatw"
  cost_center = "cc-4471"
  partition   = "govcloud"
  criticality = "tier1"
}

# Prod subnets are the most likely of the four to be proxy-only with no NAT.
# Verify BEFORE apply. Wrong value gives you healthy tasks and zero telemetry,
# which in prod is worse than an outright failure because nobody notices.
dd_proxy_https = null
# dd_proxy_https = "http://10.111.225.254:8080"

# IDENTICAL digests to dev/test/stage. Promote the artifact, do not re-mirror.
dd_agent_image     = "<acct>.dkr.ecr.us-gov-west-1.amazonaws.com/datadog/agent@sha256:REPLACE"
dd_fluentbit_image = "<acct>.dkr.ecr.us-gov-west-1.amazonaws.com/datadog/aws-for-fluent-bit@sha256:REPLACE"

module_registry = "gitlab.example.com"

# Prod pins the version that has actually soaked in stage. It is fine, and
# normal, for this to lag dev by a release.
datadog_module_version = "1.0.0"

###############################################################################
# Prod-only considerations
###############################################################################
#
# 1. agent_essential stays false (module default). An agent crash degrades
#    observability; it must not take down a tier-1 service.
#
# 2. log_router_essential stays true. A dead router means the app's log driver
#    has nowhere to write. Replacing the task is the honest outcome.
#
# 3. FireLens removes backend app logs from CloudWatch. In prod GovCloud this
#    is the most likely place for a retention or audit requirement to bite.
#    If one exists, set dd_enable_logs = false on backend_service and keep
#    awslogs -- metrics and APM still work.
#
# 4. Deploy behaviour: the new task definition revision triggers a rolling
#    replacement of every backend task. deployment_circuit_breaker with
#    rollback should already be on. Confirm before the change window.
