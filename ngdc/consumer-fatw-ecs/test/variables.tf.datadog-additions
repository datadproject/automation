variable "module_registry" {
  description = "GitLab host serving the Terraform module registry."
  type        = string
}

variable "datadog_module_version" {
  description = "Pinned version of ngdc-datadog-ecs-sidecar. Never a branch."
  type        = string
}

variable "image_tag" {
  description = "App image tag from CI. Also becomes DD_VERSION."
  type        = string
}

###############################################################################
# Datadog globals
###############################################################################

variable "dd_api_key_secret_name" {
  description = "Secrets Manager secret name. GovCloud needs a ddog-gov.com key."
  type        = string
}

variable "dd_site" {
  description = "GovCloud: ddog-gov.com"
  type        = string
  default     = "ddog-gov.com"

  validation {
    condition = !(
      can(regex("us-gov", var.aws_region)) && var.dd_site != "ddog-gov.com"
    )
    error_message = "GovCloud regions must use dd_site = \"ddog-gov.com\". A commercial-site key will silently authenticate against nothing."
  }
}

variable "dd_tags" {
  type    = map(string)
  default = {}
}

variable "dd_log_source" {
  description = "Default dd_source. Override per service via dd_log_source."
  type        = string
  default     = "ecs"
}

variable "dd_proxy_https" {
  description = "e.g. http://10.111.225.254:8080. null when subnets have NAT."
  type        = string
  default     = null
}

variable "dd_proxy_no_proxy" {
  type    = list(string)
  default = ["169.254.169.254", "169.254.170.2"]
}

variable "dd_agent_image" {
  description = "GovCloud: MUST be a private ECR repo. public.ecr.aws is unreachable."
  type        = string

  validation {
    condition     = !can(regex("^public\\.ecr\\.aws|^gcr\\.io", var.dd_agent_image))
    error_message = "public.ecr.aws and gcr.io are not reachable from GovCloud. Mirror the image into private ECR first."
  }
}

variable "dd_fluentbit_image" {
  description = "GovCloud: MUST be a private ECR repo."
  type        = string

  validation {
    condition     = !can(regex("^public\\.ecr\\.aws|^gcr\\.io", var.dd_fluentbit_image))
    error_message = "public.ecr.aws and gcr.io are not reachable from GovCloud. Mirror the image into private ECR first."
  }
}

variable "dd_sidecar_log_retention_days" {
  description = "Retention for the module-created sidecar log groups."
  type        = number
  default     = 7
}

variable "common_tags" {
  description = "Tags applied to module-created resources."
  type        = map(string)
  default     = {}
}
