###############################################################################
# consumer-fatw-ecs/dev/variables.tf.datadog-additions
#
# PASTE INTO dev/variable.tf  (note: your file is variable.tf, singular).
###############################################################################

variable "image_tag" {
  description = <<-EOT
    Becomes DD_VERSION so every trace, log line and metric carries the
    deployed build. Your images already embed a SHA, e.g.
      fatoolkit-backend-dev-48415cc1
    Pass just the SHA (48415cc1) or the whole tag -- it is a label only.

    Wire from CI: export TF_VAR_image_tag="${CI_COMMIT_SHORT_SHA}"
  EOT
  type        = string
  default     = "unset"
}

###############################################################################
# Datadog
###############################################################################

variable "dd_site" {
  description = "GovCloud: ddog-gov.com. Validated against the partition in the module."
  type        = string
  default     = "ddog-gov.com"
}

variable "dd_api_key_secret_name" {
  description = <<-EOT
    Secrets Manager secret NAME (not ARN). Terraform reads metadata only.
    Same account and region as fatw_drupal_hash_salt, which the backend
    already consumes the same way.
  EOT
  type        = string
}

variable "dd_api_key_secret_json_key" {
  description = "Key inside a JSON secret. null for a plain-string secret."
  type        = string
  default     = null
}

variable "dd_log_source" {
  description = "Default dd_source. Backend is Drupal/PHP."
  type        = string
  default     = "php"
}

# --- Images: private ECR in GovCloud, pinned -----------------------------

variable "dd_agent_image" {
  description = "Fully-qualified pinned Agent image from your GovCloud ECR."
  type        = string
}

variable "dd_fluentbit_image" {
  description = "Fully-qualified pinned aws-for-fluent-bit image. Required only when logs are on."
  type        = string
  default     = null
}

# --- Proxy: Agent and Fluent Bit are SEPARATE ----------------------------

variable "dd_agent_proxy_https" {
  description = "Agent DD_PROXY_HTTPS. null when the subnets have NAT or VPC endpoints."
  type        = string
  default     = null
}

variable "dd_agent_proxy_http" {
  description = "Agent DD_PROXY_HTTP. Falls back to dd_agent_proxy_https."
  type        = string
  default     = null
}

variable "dd_agent_proxy_no_proxy" {
  description = <<-EOT
    Extra NO_PROXY entries. The module always unions in 169.254.170.2,
    localhost and 127.0.0.1, so those need not be listed.
  EOT
  type        = list(string)
  default     = ["169.254.169.254"]
}

variable "dd_fluentbit_proxy" {
  description = <<-EOT
    Fluent Bit Datadog-output proxy. MUST be http:// form.
    Fluent Bit does NOT read DD_PROXY_HTTPS -- separate container, separate
    setting. Setting the Agent proxy without this fails at plan time.
  EOT
  type        = string
  default     = null
}

