# ecs_service -- OPTIONAL attributes added by this change
#
# Your ngdc-ecs-cluster-module types ecs_service strictly, so the CONSUMER's
# own variable must accept these. If dev/variable.tf declares ecs_service as
# `type = any`, nothing to do. If it mirrors the module's typed object, add:
#
#   datadog_enabled       = optional(bool, false)   <- the entire opt-in
#   dd_log_source         = optional(string)
#   dd_app_container_name = optional(string)
#   dd_enable_apm         = optional(bool, true)
#   dd_enable_logs        = optional(bool, true)
#   dd_enable_dogstatsd   = optional(bool, true)
#   dd_enable_profiling   = optional(bool, false)
#   dd_app_wait_for_agent = optional(bool, false)
