###############################################################################
# data.tf  --  DATADOG ADDITIONS
#
# Merge into your existing data.tf. Identical across all four environments.
###############################################################################

# Resolved by NAME so no ARN is hardcoded per account or per partition.
data "aws_secretsmanager_secret" "dd_api_key" {
  name = var.dd_api_key_secret_name
}

# GovCloud: partition is "aws-us-gov", not "aws". Build ARNs from this:
#   "arn:${data.aws_partition.current.partition}:iam::aws:policy/..."
#
# Grep every env directory AND ngdc-ecs-cluster-module for hardcoded
# "arn:aws:" -- each one is a latent GovCloud bug.
data "aws_partition" "current" {}
