ecs_task_definition_effective = {
  for td_name, td in var.ecs_task_definition :

  td_name => contains(
    keys(local.datadog_enabled_tasks),
    td_name
  ) ? merge(
    td,
    {
      container_definitions = merge(

        {
          for container_key, container in td.container_definitions :

          container_key => container

          if container_key != local.datadog_enabled_tasks[td_name].app_container_key
        },

        {
          for container_key, container in td.container_definitions :

          container_key => merge(
            container,
            {
              environment = merge(
                try(container.environment, {}),
                local.dd_app_environment[td_name]
              )

              docker_labels = merge(
                try(container.docker_labels, {}),
                local.dd_app_labels[td_name]
              )

              container_depends_on = concat(
                try(container.container_depends_on, []),
                [
                  {
                    containerName = "log_router"
                    condition     = "START"
                  }
                ]
              )

              log_configuration = local.dd_app_log_configuration[td_name]
            }
          )

          if container_key == local.datadog_enabled_tasks[td_name].app_container_key
        },

        {
          "datadog-agent" = local.dd_agent_containers[td_name]
        },

        {
          "log_router" = local.dd_log_router_containers[td_name]
        }
      )
    }
  ) : td
}