  datadog_tasks = var.datadog_tasks

  dd_site                = var.dd_site
  dd_logs_host           = var.dd_logs_host
  dd_api_key_secret_name = var.dd_api_key_secret_name

  dd_agent_image     = var.dd_agent_image
  dd_fluentbit_image = var.dd_fluentbit_image

  dd_proxy_https  = var.dd_proxy_https
  dd_proxy_no_proxy = var.dd_proxy_no_proxy


###############################################################################
# OPTIONAL DATADOG BOLT-ON
###############################################################################

variable "datadog_tasks" {
  description = "Optional Datadog configuration keyed by ECS task definition."

  type = map(object({
    enabled             = optional(bool, true)
    app_container_key   = string
    service             = string
    version             = string
    log_source          = optional(string, "ecs")
    execution_role_name = string
  }))

  default = {}
}

variable "dd_site" {
  type    = string
  default = "datadoghq.com"
}

variable "dd_logs_host" {
  type    = string
  default = null
}

variable "dd_api_key_secret_name" {
  type    = string
  default = null
}

variable "dd_agent_image" {
  type    = string
  default = null
}

variable "dd_fluentbit_image" {
  type    = string
  default = null
}

variable "dd_proxy_https" {
  type    = string
  default = null
}

variable "dd_proxy_no_proxy" {
  type = list(string)

  default = [
    "localhost",
    "127.0.0.1",
    "169.254.169.254",
    "169.254.170.2"
  ]
}


###############################################################################
# OPTIONAL DATADOG ECS FARGATE BOLT-ON
###############################################################################

locals {
  datadog_enabled_tasks = {
    for td_name, config in var.datadog_tasks :
    td_name => config
    if try(config.enabled, true)
  }
}


###############################################################################
# Validate mappings
###############################################################################

check "datadog_task_definitions_exist" {
  assert {
    condition = alltrue([
      for td_name, config in local.datadog_enabled_tasks :
      contains(keys(var.ecs_task_definition), td_name)
    ])

    error_message = "A datadog_tasks key does not exist in ecs_task_definition."
  }
}


check "datadog_app_containers_exist" {
  assert {
    condition = alltrue([
      for td_name, config in local.datadog_enabled_tasks :
      contains(
        keys(var.ecs_task_definition[td_name].container_definitions),
        config.app_container_key
      )
    ])

    error_message = "A Datadog app_container_key does not exist in the selected ECS task definition."
  }
}


###############################################################################
# Secrets Manager
#
# Terraform reads metadata / ARN only.
# It does NOT retrieve the Datadog API key value.
###############################################################################

data "aws_secretsmanager_secret" "datadog_api_key" {
  count = length(local.datadog_enabled_tasks) > 0 ? 1 : 0

  name = var.dd_api_key_secret_name
}


###############################################################################
# Execution role access to DD secret
###############################################################################

resource "aws_iam_role_policy" "datadog_secret_access" {
  for_each = local.datadog_enabled_tasks

  name = "datadog-secret-read-${lower(each.value.service)}"

  role = each.value.execution_role_name

  policy = jsonencode({
    Version = "2012-10-17"

    Statement = [
      {
        Sid    = "ReadDatadogApiKey"
        Effect = "Allow"

        Action = [
          "secretsmanager:GetSecretValue"
        ]

        Resource = [
          data.aws_secretsmanager_secret.datadog_api_key[0].arn
        ]
      }
    ]
  })
}


###############################################################################
# Datadog container definitions
###############################################################################

locals {

  ###########################################################################
  # Agent proxy
  ###########################################################################

  dd_proxy_environment = var.dd_proxy_https == null ? [] : [
    {
      name  = "DD_PROXY_HTTP"
      value = var.dd_proxy_https
    },
    {
      name  = "DD_PROXY_HTTPS"
      value = var.dd_proxy_https
    },
    {
      name  = "DD_PROXY_NO_PROXY"
      value = join(" ", var.dd_proxy_no_proxy)
    },
    {
      name  = "DD_NO_PROXY_NONEXACT_MATCH"
      value = "true"
    }
  ]


  ###########################################################################
  # Application Datadog environment
  ###########################################################################

  dd_app_environment = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      DD_ENV                     = var.environment_tag
      DD_SERVICE                 = config.service
      DD_VERSION                 = config.version

      DD_TRACE_ENABLED           = "true"
      DD_TRACE_AGENT_URL         = "http://127.0.0.1:8126"

      DD_DOGSTATSD_URL           = "udp://127.0.0.1:8125"

      DD_LOGS_INJECTION          = "true"
      DD_RUNTIME_METRICS_ENABLED = "true"
    }
  }


  ###########################################################################
  # Unified Service Tagging labels
  ###########################################################################

  dd_app_labels = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      "com.datadoghq.tags.env"     = var.environment_tag
      "com.datadoghq.tags.service" = config.service
      "com.datadoghq.tags.version" = config.version
    }
  }


  ###########################################################################
  # Datadog Agent sidecar
  ###########################################################################

  dd_agent_containers = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      container_name = "datadog-agent"

      image = var.dd_agent_image

      # Datadog failure must not stop application task.
      essential = false

      container_cpu    = 128
      container_memory = 512

      environment = concat(
        [
          {
            name  = "ECS_FARGATE"
            value = "true"
          },
          {
            name  = "DD_SITE"
            value = var.dd_site
          },
          {
            name  = "DD_ENV"
            value = var.environment_tag
          },
          {
            name  = "DD_SERVICE"
            value = config.service
          },
          {
            name  = "DD_VERSION"
            value = config.version
          },
          {
            name  = "DD_APM_ENABLED"
            value = "true"
          },
          {
            name  = "DD_APM_NON_LOCAL_TRAFFIC"
            value = "true"
          },
          {
            name  = "DD_DOGSTATSD_NON_LOCAL_TRAFFIC"
            value = "true"
          }
        ],

        local.dd_proxy_environment
      )

      secrets = [
        {
          name = "DD_API_KEY"

          valueFrom = data.aws_secretsmanager_secret.datadog_api_key[0].arn
        }
      ]

      port_mappings = [
        {
          containerPort = 8126
          hostPort      = 8126
          protocol      = "tcp"
        },
        {
          containerPort = 8125
          hostPort      = 8125
          protocol      = "udp"
        }
      ]

      health_check = {
        command = [
          "CMD-SHELL",
          "agent health"
        ]

        interval     = 15
        timeout      = 5
        retries      = 3
        start_period = 60
      }

      # Reuse existing application's CW log group for Agent diagnostics.
      awslogs_group = var.ecs_task_definition[
        td_name
      ].container_definitions[
        config.app_container_key
      ].awslogs_group

      awslogs_region = var.region

      awslogs_stream_prefix = "datadog-agent"
    }
  }


  ###########################################################################
  # Fluent Bit FireLens sidecar
  ###########################################################################

  dd_log_router_containers = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      container_name = "log_router"

      image = var.dd_fluentbit_image

      essential = true

      container_cpu    = 64
      container_memory = 128

      environment = []

      firelens_configuration = {
        type = "fluentbit"

        options = {
          "enable-ecs-log-metadata" = "true"
        }
      }

      awslogs_group = var.ecs_task_definition[
        td_name
      ].container_definitions[
        config.app_container_key
      ].awslogs_group

      awslogs_region = var.region

      awslogs_stream_prefix = "fluentbit"
    }
  }


  ###########################################################################
  # Application FireLens configuration
  ###########################################################################

  dd_app_log_configuration = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      log_driver = "awsfirelens"

      options = merge(
        {
          Name = "datadog"

          Host = var.dd_logs_host

          TLS      = "on"
          compress = "gzip"

          provider = "ecs"

          dd_service = config.service
          dd_source  = config.log_source

          dd_message_key = "log"

          dd_tags = join(",", [
            "env:${var.environment_tag}",
            "service:${config.service}",
            "version:${config.version}"
          ])
        },

        var.dd_proxy_https == null ? {} : {
          proxy = var.dd_proxy_https
        }
      )

      secret_options = [
        {
          name = "apikey"

          valueFrom = data.aws_secretsmanager_secret.datadog_api_key[0].arn
        }
      ]
    }
  }


  ###########################################################################
  # FINAL ECS TASK DEFINITIONS
  ###########################################################################

  ecs_task_definition_effective = {

    for td_name, td in var.ecs_task_definition :

    td_name => contains(
      keys(local.datadog_enabled_tasks),
      td_name
    ) ? merge(

      td,

      {
        container_definitions = merge(

          #####################################################################
          # Existing containers
          #####################################################################

          {
            for container_key, container in td.container_definitions :

            container_key => (
              container_key ==
              local.datadog_enabled_tasks[td_name].app_container_key

              ? merge(
                  container,

                  {
                    ###########################################################
                    # Preserve existing environment and add DD environment
                    ###########################################################

                    environment = [
                      for env_name, env_value in merge(

                        {
                          for item in try(container.environment, []) :
                          item.name => item.value
                        },

                        local.dd_app_environment[td_name]

                      ) :

                      {
                        name  = env_name
                        value = env_value
                      }
                    ]


                    ###########################################################
                    # Datadog Unified Service Tagging
                    ###########################################################

                    docker_labels = merge(
                      try(container.docker_labels, {}),
                      local.dd_app_labels[td_name]
                    )


                    ###########################################################
                    # Start Fluent Bit before application
                    ###########################################################

                    depends_on = concat(
                      try(container.depends_on, []),

                      [
                        {
                          containerName = "log_router"
                          condition     = "START"
                        }
                      ]
                    )


                    ###########################################################
                    # Application logs -> FireLens -> Datadog
                    ###########################################################

                    log_configuration = local.dd_app_log_configuration[
                      td_name
                    ]
                  }
                )

              : container
            )
          },


          #####################################################################
          # Add Agent
          #####################################################################

          {
            "datadog-agent" = local.dd_agent_containers[
              td_name
            ]
          },


          #####################################################################
          # Add Fluent Bit
          #####################################################################

          {
            "log_router" = local.dd_log_router_containers[
              td_name
            ]
          }
        )
      }
    )

    : td
  }
}



merge(
  {
    # KEEP ALL EXISTING FIELDS HERE

    name      = container.container_name
    image     = container.image
    essential = container.essential

    cpu    = try(container.container_cpu, null)
    memory = try(container.container_memory, null)

    environment = try(container.environment, [])

    portMappings = try(container.port_mappings, [])
  },


  ###########################################################################
  # Secrets
  ###########################################################################

  length(try(container.secrets, [])) > 0 ? {
    secrets = container.secrets
  } : {},


  ###########################################################################
  # Docker labels
  ###########################################################################

  length(try(container.docker_labels, {})) > 0 ? {
    dockerLabels = container.docker_labels
  } : {},


  ###########################################################################
  # Dependencies
  ###########################################################################

  length(try(container.depends_on, [])) > 0 ? {
    dependsOn = container.depends_on
  } : {},


  ###########################################################################
  # Health check
  ###########################################################################

  try(container.health_check, null) != null ? {
    healthCheck = {
      command = container.health_check.command

      interval = container.health_check.interval
      timeout  = container.health_check.timeout
      retries  = container.health_check.retries

      startPeriod = container.health_check.start_period
    }
  } : {},


  ###########################################################################
  # FireLens
  ###########################################################################

  try(container.firelens_configuration, null) != null ? {
    firelensConfiguration = {
      type = container.firelens_configuration.type

      options = try(
        container.firelens_configuration.options,
        {}
      )
    }
  } : {},


  ###########################################################################
  # Logging
  #
  # Explicit config wins.
  # Otherwise keep current awslogs behavior.
  ###########################################################################

  try(container.log_configuration, null) != null ? {

    logConfiguration = {
      logDriver = container.log_configuration.log_driver

      options = try(
        container.log_configuration.options,
        {}
      )

      secretOptions = try(
        container.log_configuration.secret_options,
        []
      )
    }

  } : {

    logConfiguration = {
      logDriver = "awslogs"

      options = {
        "awslogs-group" = container.awslogs_group

        "awslogs-region" = container.awslogs_region

        "awslogs-stream-prefix" = container.awslogs_stream_prefix
      }
    }
  }
)



