###############################################################################
# OPTIONAL DATADOG BOLT-ON FOR ECS FARGATE
###############################################################################

locals {
  datadog_enabled_tasks = var.datadog_tasks
}

###############################################################################
# DATADOG API KEY
###############################################################################

data "aws_secretsmanager_secret" "datadog_api_key" {
  count = length(local.datadog_enabled_tasks) > 0 ? 1 : 0

  name = var.dd_api_key_secret_name
}

###############################################################################
# ALLOW EXISTING ECS EXECUTION ROLE TO READ DATADOG API KEY
###############################################################################

resource "aws_iam_role_policy" "datadog_secret_access" {
  for_each = local.datadog_enabled_tasks

  name = "datadog-secret-read-${lower(each.value.service)}"

  role = element(
    reverse(
      split(
        "/",
        var.ecs_task_definition[each.key].task_execution_role
      )
    ),
    0
  )

  policy = jsonencode({
    Version = "2012-10-17"

    Statement = [
      {
        Sid    = "ReadDatadogApiKey"
        Effect = "Allow"

        Action = [
          "secretsmanager:GetSecretValue"
        ]

        Resource = [
          data.aws_secretsmanager_secret.datadog_api_key[0].arn
        ]
      }
    ]
  })
}

###############################################################################
# DATADOG CONTAINER CONFIGURATION
###############################################################################

locals {

  #############################################################################
  # APPLICATION DATADOG ENVIRONMENT
  #############################################################################

  dd_app_environment = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      DD_ENV                     = var.environment_tag
      DD_SERVICE                 = config.service
      DD_VERSION                 = config.version
      DD_AGENT_HOST              = "127.0.0.1"
      DD_TRACE_ENABLED           = "true"
      DD_TRACE_AGENT_PORT        = "8126"
      DD_DOGSTATSD_PORT          = "8125"
      DD_LOGS_INJECTION          = "true"
      DD_RUNTIME_METRICS_ENABLED = "true"
    }
  }

  #############################################################################
  # APPLICATION DATADOG LABELS
  #############################################################################

  dd_app_labels = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      "com.datadoghq.tags.env"     = var.environment_tag
      "com.datadoghq.tags.service" = config.service
      "com.datadoghq.tags.version" = config.version
    }
  }

  #############################################################################
  # DATADOG AGENT
  #############################################################################

  dd_agent_containers = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      container_name = "datadog-agent"
      image          = var.dd_agent_image
      essential      = false

      environment = merge(
        {
          ECS_FARGATE                    = "true"
          DD_SITE                        = var.dd_site
          DD_ENV                         = var.environment_tag
          DD_SERVICE                     = config.service
          DD_VERSION                     = config.version
          DD_APM_ENABLED                 = "true"
          DD_APM_NON_LOCAL_TRAFFIC       = "true"
          DD_DOGSTATSD_NON_LOCAL_TRAFFIC = "true"
          DD_DOGSTATSD_TAG_CARDINALITY   = "orchestrator"
        },

        var.dd_proxy_https != null ? {
          DD_PROXY_HTTP              = var.dd_proxy_https
          DD_PROXY_HTTPS             = var.dd_proxy_https
          DD_PROXY_NO_PROXY          = join(" ", var.dd_proxy_no_proxy)
          DD_NO_PROXY_NONEXACT_MATCH = "true"
        } : {}
      )

      secrets = [
        {
          name      = "DD_API_KEY"
          valueFrom = data.aws_secretsmanager_secret.datadog_api_key[0].arn
        }
      ]

      port_mappings = [
        {
          containerPort = 8126
          hostPort      = 8126
          protocol      = "tcp"
        },
        {
          containerPort = 8125
          hostPort      = 8125
          protocol      = "udp"
        }
      ]

      health_check = {
        command     = ["CMD-SHELL", "agent health"]
        interval    = 30
        timeout     = 5
        retries     = 3
        startPeriod = 15
      }

      container_depends_on   = []
      firelens_configuration = null
      log_configuration      = null
      docker_labels          = {}
      mount_points           = []
    }
  }

  #############################################################################
  # FLUENT BIT / FIRELENS
  #############################################################################

  dd_log_router_containers = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      container_name = "log_router"
      image          = var.dd_fluentbit_image
      essential      = true

      environment = {}

      secrets       = []
      port_mappings = []
      health_check  = null

      container_depends_on = []

      firelens_configuration = {
        type = "fluentbit"

        options = {
          "enable-ecs-log-metadata" = "true"
        }
      }

      log_configuration = null
      docker_labels     = {}
      mount_points      = []
    }
  }

  #############################################################################
  # APPLICATION LOGGING -> FIRELENS -> DATADOG
  #############################################################################

  dd_app_log_configuration = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => {
      logDriver = "awsfirelens"

      options = merge(
        {
          Name           = "datadog"
          Host           = var.dd_logs_host
          TLS            = "on"
          compress       = "gzip"
          provider       = "ecs"
          dd_service     = config.service
          dd_source      = config.log_source
          dd_message_key = "log"

          dd_tags = join(",", [
            "env:${var.environment_tag}",
            "service:${config.service}",
            "version:${config.version}"
          ])
        },

        var.dd_proxy_https != null ? {
          proxy = var.dd_proxy_https
        } : {}
      )

      secretOptions = [
        {
          name      = "apikey"
          valueFrom = data.aws_secretsmanager_secret.datadog_api_key[0].arn
        }
      ]
    }
  }

  #############################################################################
  # BUILD ONLY THE TASK DEFINITIONS THAT NEED DATADOG
  #############################################################################

  datadog_task_definition_overrides = {
    for td_name, config in local.datadog_enabled_tasks :

    td_name => merge(
      var.ecs_task_definition[td_name],

      {
        container_definitions = merge(

          #####################################################################
          # KEEP ALL EXISTING CONTAINERS
          #####################################################################

          var.ecs_task_definition[td_name].container_definitions,

          #####################################################################
          # MODIFY ONLY THE APPLICATION CONTAINER
          #####################################################################

          {
            (config.app_container_key) = merge(
              var.ecs_task_definition[
                td_name
              ].container_definitions[
                config.app_container_key
              ],

              {
                environment = merge(
                  try(
                    var.ecs_task_definition[
                      td_name
                    ].container_definitions[
                      config.app_container_key
                    ].environment,
                    {}
                  ),

                  local.dd_app_environment[td_name]
                )

                docker_labels = merge(
                  try(
                    var.ecs_task_definition[
                      td_name
                    ].container_definitions[
                      config.app_container_key
                    ].docker_labels,
                    {}
                  ),

                  local.dd_app_labels[td_name]
                )

                container_depends_on = concat(
                  try(
                    var.ecs_task_definition[
                      td_name
                    ].container_definitions[
                      config.app_container_key
                    ].container_depends_on,
                    []
                  ),

                  [
                    {
                      containerName = "log_router"
                      condition     = "START"
                    }
                  ]
                )

                log_configuration = local.dd_app_log_configuration[
                  td_name
                ]
              }
            )
          },

          #####################################################################
          # ADD DATADOG AGENT
          #####################################################################

          {
            "datadog-agent" = local.dd_agent_containers[
              td_name
            ]
          },

          #####################################################################
          # ADD FLUENT BIT
          #####################################################################

          {
            "log_router" = local.dd_log_router_containers[
              td_name
            ]
          }
        )
      }
    )
  }

  #############################################################################
  # FINAL TASK DEFINITIONS
  #
  # Non-Datadog TDs remain exactly as they are.
  # Datadog TDs replace only their matching entry.
  #############################################################################

  ecs_task_definition_effective = merge(
    var.ecs_task_definition,
    local.datadog_task_definition_overrides
  )
}