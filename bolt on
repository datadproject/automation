"FATW-Dev-Backend-TD" = {
  family                   = "FATW-Dev-Backend-TD"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]

  cpu    = 1024
  memory = 2048

  datadog = {
    enabled    = true
    service    = "backend-service"
    log_source = "php"

    api_key_secret_name = "fatw_datadog_api_key"

    site = "ddog-gov.com"

    agent_image = "YOUR-ECR/datadog-agent:7.66.1"

    fluentbit_image = "YOUR-ECR/aws-for-fluent-bit:2.32.5"

    proxy = "http://10.111.225.254:8080"
  }

  container_definitions = {
    "FATW-Dev-Backend-CB" = {
      # your existing configuration stays here
    }
  }
}







datadog = optional(object({
  enabled             = optional(bool, false)
  service             = string
  log_source          = optional(string, "ecs")
  api_key_secret_name = string
  site                = optional(string, "datadoghq.com")

  agent_image     = string
  fluentbit_image = string

  proxy = optional(string)
}))

data "aws_secretsmanager_secret" "datadog" {
  for_each = {
    for name, td in var.ecs_task_definition :
    name => td
    if try(td.datadog.enabled, false)
  }

  name = each.value.datadog.api_key_secret_name
}

locals {
  datadog_agent = {
    for name, td in var.ecs_task_definition :

    name => {
      name      = "datadog-agent"
      image     = td.datadog.agent_image
      essential = false

      cpu    = 128
      memory = 512

      environment = concat(
        [
          {
            name  = "ECS_FARGATE"
            value = "true"
          },
          {
            name  = "DD_SITE"
            value = td.datadog.site
          },
          {
            name  = "DD_ENV"
            value = var.environment_tag
          },
          {
            name  = "DD_SERVICE"
            value = td.datadog.service
          },
          {
            name  = "DD_APM_ENABLED"
            value = "true"
          },
          {
            name  = "DD_APM_NON_LOCAL_TRAFFIC"
            value = "true"
          },
          {
            name  = "DD_DOGSTATSD_NON_LOCAL_TRAFFIC"
            value = "true"
          }
        ],

        try(td.datadog.proxy, null) == null ? [] : [
          {
            name  = "DD_PROXY_HTTP"
            value = td.datadog.proxy
          },
          {
            name  = "DD_PROXY_HTTPS"
            value = td.datadog.proxy
          },
          {
            name  = "DD_PROXY_NO_PROXY"
            value = "localhost 127.0.0.1 169.254.169.254 169.254.170.2"
          },
          {
            name  = "DD_NO_PROXY_NONEXACT_MATCH"
            value = "true"
          }
        ]
      )

      secrets = [
        {
          name      = "DD_API_KEY"
          valueFrom = data.aws_secretsmanager_secret.datadog[name].arn
        }
      ]

      healthCheck = {
        command     = ["CMD-SHELL", "agent health"]
        interval    = 15
        timeout     = 5
        retries     = 3
        startPeriod = 60
      }

      portMappings = [
        {
          containerPort = 8126
          hostPort      = 8126
          protocol      = "tcp"
        },
        {
          containerPort = 8125
          hostPort      = 8125
          protocol      = "udp"
        }
      ]
    }

    if try(td.datadog.enabled, false)
  }
}
