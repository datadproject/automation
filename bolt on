variable "datadog_tasks" {
  description = "Task definitions that should receive the Datadog bolt-on."

  type = map(object({
    enabled             = optional(bool, true)
    app_container_key   = string
    service             = string
    version             = string
    log_source          = optional(string, "ecs")
    execution_role_name = string
  }))

  default = {}
}

variable "dd_site" {
  description = "Datadog site."
  type        = string
  default     = "ddog-gov.com"
}

variable "dd_logs_host" {
  description = "Datadog Logs intake hostname."
  type        = string
}

variable "dd_api_key_secret_name" {
  description = "Secrets Manager secret containing the Datadog API key."
  type        = string
}

variable "dd_agent_image" {
  description = "Private ECR Datadog Agent image."
  type        = string
}

variable "dd_fluentbit_image" {
  description = "Private ECR AWS for Fluent Bit image."
  type        = string
}

variable "dd_proxy_https" {
  description = "Corporate proxy."
  type        = string
  default     = null
}

variable "dd_proxy_no_proxy" {
  type = list(string)

  default = [
    "localhost",
    "127.0.0.1",
    "169.254.169.254",
    "169.254.170.2"
  ]
}




